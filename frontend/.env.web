# Web 端环境变量配置
# 用于 Web 端构建和部署

# API 基础 URL - campus 知识接口与页面同源（留空 = 相对路径）。
# 注意：envDir 修复后此文件真正生效，不要在这里填 localhost（否则 App/远程构建会指向本机）
VITE_API_BASE_URL=

# WebSocket 连接 URL
VITE_WS_URL=ws://localhost:12393/client-ws

# 环境类型
VITE_ENV=web

# 是否启用调试模式
VITE_DEBUG=false

# 静态资源 CDN (可选，用于生产环境)
# VITE_CDN_URL=https://cdn.example.com

# 安卓 App（Capacitor）内置前端默认指向的后端服务器
VITE_REMOTE_SERVER=http://183.36.243.124:12393
